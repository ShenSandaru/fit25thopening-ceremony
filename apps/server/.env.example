# Copy to apps/server/.env and adjust. Never commit the real .env file.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
COUNTDOWN_DURATION_MS=5000
PREPARATION_DELAY_MS=0
LOG_LEVEL=info

# How long a disconnected tablet keeps its guest role (milliseconds).
SESSION_RECONNECT_GRACE_MS=60000

# Set true when the site is served over HTTPS. Defaults to true in production.
# COOKIE_SECURE=false

# Admin password hash is added in a later phase. Guests do not use passwords.
# ADMIN_PASSWORD_HASH=scrypt$...
